# Copy this file to `.env` and fill in real values from your mbe-api dev
# database, then run:
#   flutter test --dart-define-from-file=.env
#
# These are compile-time constants (String.fromEnvironment), consumed by
# test/integration/*_test.dart. Any value left blank causes the tests that
# depend on it to be skipped rather than fail — fill in only what you have
# seeded data for.
#
# Requires mbe-api reachable at `apiBaseUrl` (default http://127.0.0.1:8000).

# =============================================================================
# App settings (spec 027) — deployment configuration, resolved once at
# startup via lib/core/config/app_settings.dart. Every key below has a
# documented default; the app starts and runs correctly with none of them
# set. These are the same `--dart-define-from-file` mechanism as the test
# credentials above, but a different audience: a real deployment sets these
# in its own file (e.g. deploy/<customer>.env, see deploy/README.md) rather
# than in this developer-local, gitignored .env.
# =============================================================================

# mbe-api base URL.
API_BASE_URL=http://127.0.0.1:8000
# Legacy photo virtual-root base URL. Defaults to API_BASE_URL.
PHOTOS_BASE_URL=
# The walk-in customer id a new POS sale defaults to.
POS_DEFAULT_CUSTOMER_ID=1
# Deployment display name.
BRAND_DISPLAY_NAME=Mictlanix Business Essentials
# Deployment seed color (RRGGBB/#RRGGBB). Unset ⇒ the default XBE palette.
BRAND_SEED_COLOR=
# Home welcome image asset path. Unset ⇒ the bundled default placeholder.
BRAND_WELCOME_ASSET=
# Login branding pane lockup (icon + wordmark) asset path.
BRAND_LOCKUP_ASSET=assets/brand/login_lockup.png
# Navigation header isologo mark asset path.
BRAND_MARK_ASSET=assets/brand/nav_lockup.png
# Deployment's default locale (e.g. es_MX, en_US) — the language a user gets
# before/absent a personal language override on the settings screen.
DEFAULT_LOCALE=es_MX

# --- Value formatting (spec 028) — resolved once at startup via
# lib/core/config/formatting_settings.dart, consumed everywhere through
# formattersProvider (lib/core/formatting/). Never reachable from the UI —
# unlike DEFAULT_LOCALE above, there is no per-user override for any of
# these; the deployment's choice is the only choice. Every DateFormat
# pattern accepts either an explicit pattern (identical layout in every
# locale — what the defaults below use) or a skeleton (resolved per locale,
# e.g. `yMd` renders `17/8/2026` in es_MX but `8/17/2026` in en). Worked
# examples below all format 2026-08-17 14:30.
#
# Date pattern. Default is ISO 8601 — a deliberate choice over the
# locale-derived rendering (`d/M/yyyy` → 17/8/2026) this app used before
# spec 028, made so one deployment serving multiple locales still gets one
# unambiguous date everywhere.
#   yyyy-MM-dd   -> 2026-08-17   (default; ISO 8601, identical in every locale)
#   d/M/yyyy     -> 17/8/2026    (short local format)
#   dd/MM/yyyy   -> 17/08/2026   (zero-padded local format)
DATE_FORMAT=yyyy-MM-dd
# Date-time pattern — same rule as DATE_FORMAT, plus a 24-hour time part.
#   yyyy-MM-dd HH:mm  -> 2026-08-17 14:30   (default)
#   d/M/yyyy HH:mm    -> 17/8/2026 14:30
DATE_TIME_FORMAT=yyyy-MM-dd HH:mm
# Currency symbol prefix.
#   $ (default) with CURRENCY_DECIMAL_DIGITS=2 -> 1234.5 formats as $1,234.50
CURRENCY_SYMBOL=$
# ISO 4217 currency code, carried for display/reporting. Not read by the
# symbol-prefixed rendering above.
CURRENCY_CODE=MXN
# Decimal digits for a currency amount.
CURRENCY_DECIMAL_DIGITS=2
# Decimal digits for a percentage.
#   2 (default) -> 0.16 formats as 16.00 %
PERCENT_DECIMAL_DIGITS=2
# Decimal digits for a quantity. 0 (the default) means natural precision
# with trailing zeros dropped, never rounded — today's exact behavior:
# 3.0000 -> 3, 2.5000 -> 2.5. A value greater than 0 caps the shown
# precision at that many decimals instead.
QUANTITY_DECIMAL_DIGITS=0

# --- auth_flow_test.dart ---
# Administrator account (full access rights).
MBE_ADMIN_USERNAME=
MBE_ADMIN_PASSWORD=
# Non-administrator account with standard access.
MBE_TEST_USERNAME=
MBE_TEST_PASSWORD=

# --- catalog_consistency_flow_test.dart (in addition to the above) ---
# Any user id known to exist, for cross-checking user lookups.
MBE_KNOWN_USER_ID=
# Account with read-only privileges (no create/update/delete rights).
MBE_READONLY_USERNAME=
MBE_READONLY_PASSWORD=

# --- product_catalog_flow_test.dart (in addition to MBE_TEST_USERNAME/PASSWORD) ---
# Product code known to exist in the catalog.
MBE_KNOWN_PRODUCT_CODE=
# Substring known to match at least one product name.
MBE_KNOWN_PRODUCT_NAME_PART=
# Account with products.create rights, used for create/update/deactivate flows.
MBE_CREATE_TEST_USERNAME=
MBE_CREATE_TEST_PASSWORD=

# --- product_photo_flow_test.dart (in addition to MBE_TEST_USERNAME/PASSWORD and
# MBE_READONLY_USERNAME/PASSWORD above) ---
# Product id that already has a photo.
MBE_WITH_PHOTO_PRODUCT_ID=
# Product id that has no photo.
MBE_NO_PHOTO_PRODUCT_ID=
# Product id safe to mutate (upload/replace/remove photo) without affecting
# other tests or real data.
MBE_MUTABLE_PRODUCT_ID=

# --- catalog_master_flow_test.dart (spec 012) ---
# Account with create+delete rights on Employees/Customers/PriceLists/
# TaxpayerRecipients (the admin account short-circuits all privilege checks).
MBE_CATALOG_TEST_USERNAME=
MBE_CATALOG_TEST_PASSWORD=

# --- cash_session_flow_test.dart (spec 021) ---
# Account with POS read+create, CASH_SESSION_CLOSE update, and at least one
# cash drawer visible to it (the admin account short-circuits all privilege
# checks). This test opens and closes a real session on every run.
MBE_CASH_SESSION_USERNAME=
MBE_CASH_SESSION_PASSWORD=

# --- pos_counter_sale_flow_test.dart, pos_delivery_split_flow_test.dart,
#     pos_resume_flow_test.dart, pos_sales_list_flow_test.dart (spec 020/023) ---
# Account with an already open cash session on its point of sale.
MBE_POS_USERNAME=
MBE_POS_PASSWORD=
# Substring known to match at least one sellable product with stock
# (optional, defaults to 'a' — too broad to find anything on most dev
# datasets; set this if the default finds nothing).
MBE_POS_PRODUCT_PATTERN=
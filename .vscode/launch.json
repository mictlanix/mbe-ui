    "version": "0.2.0",
    "configurations": [
        {
            "name": "mbe-ui",
            "request": "launch",
            "type": "dart",
            "args": [
                "-d",
                "chrome",
                "--web-port=8081",
                "--dart-define=PHOTOS_BASE_URL=http://127.0.0.1:8000",
                "--dart-define=ENABLE_FLUTTER_DRIVER_EXTENSION=false",
                "--dart-define=BRAND_DISPLAY_NAME=Business Essentials",
                "--dart-define-from-file=/Users/augusto/development/repos/mictlanix/mbe-ui/.env.settings"
            ]
        },
        {
            "name": "mbe-ui + driver",
            "request": "launch",
            "type": "dart",
            "args": [
                "-d",
                "chrome",
                "--web-port=8081",
                "--dart-define=PHOTOS_BASE_URL=http://127.0.0.1:8000"
            ]
        },
        {

# Casa Maestra deployment (spec 077): the Casa Maestra brand.
# Same --dart-define-from-file mechanism as deploy/README.md; every other key
# falls back to its documented default (see .env.template).
# Never set BRAND_ID here: tool/release.sh passes it from the brand (BRAND in
# deploy/cm.release), so there is one source of truth.
#
# PLACEHOLDER: replace with the real Casa Maestra API URL before releasing.
# tool/release.sh refuses a host ending in .invalid.
API_BASE_URL=https://api.cm.invalid
